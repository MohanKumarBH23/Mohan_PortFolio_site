  "api": {
    "baseUrl": "",
    "timeoutMs": 8000,
    "maxRetries": 2,
    "retryDelayMs": 500,
    "endpoints": {
      "googleAppsScriptUrl": "https://script.google.com/macros/s/AKfycbxfedfx6d6SaB4y00f68BEISftfM4x4siy4FOSXBqbKUfnmzImQgTAW_qWYfUxtdd--/exec",
