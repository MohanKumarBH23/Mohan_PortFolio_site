  "storage": {
    "themeKey": "mohan_theme",
    "inquiriesKey": "mohan_portfolio_inquiries",
    "cooldownKey": "mohan_contact_cooldown_until"
  },
  "theme": {
    "defaultTheme": "dark",
    "themes": {
      "dark": {
        "label": "Dark Mineral Lacquer",
        "themeColor": "#121110"
      },
      "light": {
        "label": "Navy & Cream (Coral)",
        "themeColor": "#FAF7F2"
      }
    }
  },
  "environments": {
    "development": {
      "hostnames": ["localhost", "127.0.0.1", "0.0.0.0"],
      "logLevel": "debug",
      "enableStoreLogger": true
    },
    "staging": {
      "hostnames": ["vercel.app", "netlify.app"],
      "logLevel": "info",
      "enableStoreLogger": false
    },
    "production": {
      "hostnames": ["mohankumarbh.dev", "www.mohankumarbh.dev"],
