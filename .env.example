# ============================================================================
# Environment Configuration Template — Mohan Kumar B.H Portfolio
# Copy to `.env` and customize per environment, then run `npm run env:build`.
# NEVER commit `.env` or private credentials to version control.
# ============================================================================

# Active environment: development | staging | production (auto-detected if omitted)
APP_ENV=development

# Public site metadata
SITE_URL=https://mohankumarbh.dev
CONTACT_RECIPIENT_EMAIL=mohankumarbh007@gmail.com

# API & Webhook Endpoints (client-safe public endpoints)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/mohankumarbh007@gmail.com

# Optional Future REST API Base URL (for scalable backend integration)
API_BASE_URL=

# Network & Resilience Settings
API_TIMEOUT_MS=8000
API_MAX_RETRIES=2
API_RETRY_DELAY_MS=500

# Contact Form Controls
CONTACT_COOLDOWN_MS=30000
CONTACT_MAX_HISTORY=50

# Client Storage Keys
THEME_STORAGE_KEY=mohan_theme
INQUIRY_STORAGE_KEY=mohan_portfolio_inquiries
COOLDOWN_STORAGE_KEY=mohan_contact_cooldown_until

# Observability
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Server-Side / Google Apps Script Properties (Configure in Apps Script UI!)
# Project Settings -> Script Properties:
#   SPREADSHEET_ID=your-google-spreadsheet-id
#   RECIPIENT_EMAIL=mohankumarbh007@gmail.com
#   TIMEZONE=Asia/Kolkata
# ----------------------------------------------------------------------------

